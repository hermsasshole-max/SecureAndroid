<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permits non-executing HttpURLConnection HEAD redirect preflight on legacy http:// shortened links -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
